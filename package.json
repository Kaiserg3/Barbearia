{
  "name": "bravo-barbearia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:preview": "npm run build && node scripts/build-preview.mjs",
    "build:light": "npm run build:preview && node scripts/build-light-preview.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/*.test.js src/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.12",
    "vite": "^6.4.0"
  }
}
